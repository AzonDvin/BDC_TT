    {"id": "sanctioned_magic", "name": "Lore of Sanctioned Magic", "page": 63, "spells": [
      {"n": 1, "name": "Arcane Missile", "keyword": "Attack", "casting": 7, "critical": 10, "text": "The closest visible enemy within 15\" is hit with the attack.", "crit_text": "Add 1 to the Damage value.", "attack": {"rend": -1, "damage": "d3"}},
      {"n": 2, "name": "Flaming Weapon", "keyword": "Enchant", "casting": 7, "critical": 10, "text": "Pick a visible friendly fighter within 6\"; 1 of its melee weapons is ignited until end of round: gains Arcane and improve Rend by 1.", "crit_text": "Range 12\"."},
      {"n": 3, "name": "Eldritch Barrier", "keyword": "Cantrip", "casting": 7, "critical": 10, "text": "Pick 2 visible points within 9\" of the caster, within 6\" of each other, same elevation; a barrier between them until end of round or caster taken down. -1 to ranged attack rolls crossing it; fighters activated in it or moving across it suffer d3 damage.", "crit_text": "Points may be 9\" apart."},
      {"n": 4, "name": "Silence", "keyword": "Hex", "casting": 7, "critical": 10, "text": "A visible enemy Wizard or Priest within 12\" cannot make arcane actions until end of round.", "crit_text": "Range 18\"."},
      {"n": 5, "name": "Torrent of Fire", "keyword": "Attack", "casting": 8, "critical": 12, "text": "Place the flame template; each fighter in it is hit with the attack.", "crit_text": "Rend -2.", "attack": {"rend": -1, "damage": "d3+1"}},
      {"n": 6, "name": "Umbral Vortex", "keyword": "Attack", "casting": 9, "critical": 13, "text": "Blast template on a visible point within 15\", scatters d6\"; each fighter in it is hit. The vortex remains until end of round: blocks LoS at the same elevation, and fighters starting activation in it or moving across it are hit with the same attack.", "crit_text": "It does not scatter.", "attack": {"rend": -1, "damage": "d3+1"}}
    ]},
    {"id": "saints", "name": "Lore of the Saints", "page": 64, "spells": [
      {"n": 1, "name": "Healing Essence", "keyword": "Healing", "casting": 6, "critical": 10, "text": "A visible friendly fighter within 15\" heals d3 life.", "crit_text": "Heal 3 instead."},
      {"n": 2, "name": "Bless Thy Blade", "keyword": "Enchant", "casting": 7, "critical": 10, "text": "A visible friendly fighter within 9\" adds 1 to hit rolls for melee attacks until end of round.", "crit_text": "Up to 2 fighters."},
